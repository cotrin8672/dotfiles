<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pastel Bar</title>
  <script>
    const widgetState = window.__ZEBAR_STATE || JSON.parse(sessionStorage.getItem('ZEBAR_STATE') || 'null');
    if (widgetState && ['bar', 'hardware', 'active', 'ai'].includes(widgetState.name)) document.documentElement.dataset.group = widgetState.name;
  </script>
  <link rel="stylesheet" href="./style.css">
</head>
<body>
  <svg class="symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <symbol id="icon-cpu" viewBox="0 0 24 24">
      <rect x="5" y="5" width="14" height="14" rx="3"/><rect x="9" y="9" width="6" height="6" rx="1"/>
      <path d="M9 2v3m6-3v3M9 19v3m6-3v3M2 9h3m-3 6h3m14-6h3m-3 6h3"/>
    </symbol>
    <symbol id="icon-gpu" viewBox="0 0 24 24">
      <rect x="3" y="4" width="18" height="15" rx="3"/><circle cx="12" cy="11.5" r="4.5"/>
      <path d="m12 7 1 3.5 3.5 1-3.5 1L12 16l-1-3.5-3.5-1 3.5-1zM7 19v2m10-2v2"/>
    </symbol>
    <symbol id="icon-ram" viewBox="0 0 24 24">
      <rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10v4m5-4v4m5-4v4M7 18v3m5-3v3m5-3v3"/>
    </symbol>
  </svg>
  <main class="bar" aria-label="システムとAIの使用状況">
    <section class="pill hardware" aria-label="ハードウェア使用率">
      <div class="metric cpu" id="cpu">
        <svg class="icon" aria-hidden="true"><use href="#icon-cpu"/></svg>
        <div class="reading"><span class="caption">CPU</span><span class="value">--</span></div>
        <svg class="spark" viewBox="0 0 64 22" aria-hidden="true"><path class="area"/><path class="line"/></svg>
      </div>
      <div class="metric gpu" id="gpu">
        <svg class="icon" aria-hidden="true"><use href="#icon-gpu"/></svg>
        <div class="reading"><span class="caption">GPU</span><span class="value">--</span></div>
        <svg class="spark" viewBox="0 0 64 22" aria-hidden="true"><path class="area"/><path class="line"/></svg>
      </div>
      <div class="metric ram" id="ram">
        <svg class="icon" aria-hidden="true"><use href="#icon-ram"/></svg>
        <div class="reading"><span class="caption">RAM</span><span class="value">--</span></div>
        <svg class="spark" viewBox="0 0 64 22" aria-hidden="true"><path class="area"/><path class="line"/></svg>
      </div>
    </section>
    <section class="pill active-window" id="active-window" aria-label="アクティブなウィンドウ">
      <img id="app-icon" width="18" height="18" alt="" hidden>
      <span id="window-title">Desktop</span>
    </section>
    <section class="pill ai" aria-label="AIの制限枠の残量">
      <div class="provider codex" id="codex">
        <img class="brand-icon" src="./assets/openai.svg" alt="" width="21" height="21">
        <span class="provider-name">Codex</span><div class="quotas"><span class="empty">--</span></div>
      </div>
      <div class="provider claude" id="claude">
        <img class="brand-icon" src="./assets/claude.svg" alt="" width="21" height="21">
        <span class="provider-name">Claude<br>Code</span><div class="quotas"><span class="empty">--</span></div>
      </div>
    </section>
  </main>
  <script src="./ui.js"></script>
  <script type="module" src="./runtime.js"></script>
</body>
</html>
