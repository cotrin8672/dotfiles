{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "pastel-bar",
  "version": "1.0.0",
  "description": "Flat pastel hardware, active window, and AI usage pills.",
  "tags": [
    "topbar"
  ],
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js",
        "*.ps1",
        "*.cs",
        "vendor/*",
        "assets/*"
      ],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "52px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "hardware",
      "htmlPath": "./index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js",
        "*.ps1",
        "*.cs",
        "vendor/*",
        "assets/*"
      ],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell.exe",
            "argsRegex": "^-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File (?:\"[^\"]+[\\\\/]collect\\.ps1\"|[^\"]+[\\\\/]collect\\.ps1)$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "-426px",
          "offsetY": "8px",
          "width": "484px",
          "height": "34px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "active",
      "htmlPath": "./index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js",
        "*.ps1",
        "*.cs",
        "vendor/*",
        "assets/*"
      ],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "32px",
          "offsetY": "8px",
          "width": "320px",
          "height": "34px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "ai",
      "htmlPath": "./index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js",
        "*.ps1",
        "*.cs",
        "vendor/*",
        "assets/*"
      ],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "458px",
          "offsetY": "8px",
          "width": "421px",
          "height": "34px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
