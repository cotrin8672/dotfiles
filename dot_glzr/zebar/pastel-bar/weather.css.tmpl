:root {
  color-scheme: dark;
  font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
  color: #f1f1f3;
}
* { box-sizing: border-box; }
html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: transparent; }
body { user-select: none; }
.symbols { position: absolute; width: 0; height: 0; overflow: hidden; }
.pill { display: flex; align-items: center; justify-content: space-between; gap: 6px; width: 100%; height: 34px; padding: 0 12px; border-radius: 999px; white-space: nowrap; }
:root[data-preview] .pill { background: #36383d; }
.weather, .date { display: flex; align-items: center; gap: 5px; min-width: 0; }
.weather { flex: 0 0 auto; gap: 4px; }
.temperature { font-size: 12px; line-height: 13px; font-weight: 500; font-variant-numeric: tabular-nums; }
/* The condition stays available to screen readers and the tooltip. */
.visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.date { flex: 0 0 auto; padding: 0; border: 0; color: inherit; background: transparent; font: inherit; text-align: left; cursor: pointer; }
.date:focus-visible { outline: 1px solid #d3d5da; outline-offset: 3px; border-radius: 2px; }
.icon { width: 16px; height: 16px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.calendar-icon { width: 15px; height: 15px; }
.reading { display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.reading strong, .reading small { display: block; overflow: hidden; text-overflow: ellipsis; }
.reading strong { font-size: 12px; line-height: 13px; font-weight: 500; font-variant-numeric: tabular-nums; }
.reading small { color: #bfc1c6; font-size: 10px; line-height: 11px; }
.separator { width: 1px; height: 18px; flex: 0 0 auto; background: #66686c; }
