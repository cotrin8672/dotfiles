:root {
  color-scheme: dark;
  font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
  font-synthesis: none;
  color: #efeff1;
}
* { box-sizing: border-box; }
html, body { width: 100%; height: 100%; margin: 0; background: transparent; }
body { user-select: none; }
[hidden] { display: none !important; }
.calendar {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 14px 14px 12px;
  border-radius: 13px;
  background: #36383d;
}
.calendar-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
h1 { margin: 0; font-size: 12px; font-weight: 500; }
.month-controls { display: flex; gap: 2px; }
.month-controls button {
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  padding: 4px;
  border: 0;
  border-radius: 4px;
  color: #e8e8ea;
  background: transparent;
  cursor: pointer;
}
.month-controls button:hover { background: #505258; }
.month-controls button:focus-visible { outline: 2px solid #b6a3db; outline-offset: 1px; }
.month-controls svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
table { flex: 1; width: 100%; table-layout: fixed; border-collapse: collapse; text-align: center; font-size: 11px; font-variant-numeric: tabular-nums; }
th { height: 23px; color: #adafb5; font-weight: 400; }
td { height: 24px; padding: 0; }
td span { display: grid; place-items: center; width: 24px; height: 24px; margin: auto; border-radius: 50%; }
td .today { color: #292a2e; background: #dedfe2; font-weight: 500; }
