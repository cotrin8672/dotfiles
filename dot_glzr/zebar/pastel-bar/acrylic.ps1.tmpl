[Windows.UI.Composition.Compositor, Windows.UI.Composition, ContentType=WindowsRuntime] > $null
[Windows.UI.Composition.Desktop.DesktopWindowTarget, Windows.UI.Composition, ContentType=WindowsRuntime] > $null
Add-Type -Path (Join-Path $PSScriptRoot 'AcrylicLayer.cs')
[PastelAcrylic]::Initialize()
$script:PillCompositor = New-Object Windows.UI.Composition.Compositor
$script:PillVisuals = @{}
$script:PillShown = @{}

function Update-PillAcrylic([int]$ParentId) {
    $shown = @{}
    foreach ($row in [PastelAcrylic]::Sync($ParentId)) {
        $key = [long]$row[0]
        $shown[$key] = $true
        $size = New-Object System.Numerics.Vector2([float]$row[1], [float]$row[2])
        if (!$script:PillVisuals.ContainsKey($key)) {
            $target = [Windows.UI.Composition.Desktop.DesktopWindowTarget]([PastelAcrylic]::Target($script:PillCompositor, [IntPtr]$key))
            $root = $script:PillCompositor.CreateContainerVisual()
            $shape = $script:PillCompositor.CreateRoundedRectangleGeometry()
            $root.Clip = $script:PillCompositor.CreateGeometricClip($shape)
            $blur = $script:PillCompositor.CreateSpriteVisual()
            $blur.Brush = $script:PillCompositor.CreateHostBackdropBrush()
            $tint = $script:PillCompositor.CreateSpriteVisual()
            $smoke = New-Object Windows.UI.Color
            # The spacer gets a lighter, darker-hued tint so the pills stay distinct on top of it.
            if ($row[3]) { $smoke.A = 110; $smoke.R = 30; $smoke.G = 32; $smoke.B = 36 }
            else { $smoke.A = 153; $smoke.R = 53; $smoke.G = 56; $smoke.B = 61 }
            $tint.Brush = $script:PillCompositor.CreateColorBrush($smoke)
            $root.Children.InsertAtTop($blur)
            $root.Children.InsertAtTop($tint)
            $target.Root = $root
            $script:PillVisuals[$key] = @{ target=$target;root=$root;shape=$shape;blur=$blur;tint=$tint }
            if (!$row[3]) {
                $border = $script:PillCompositor.CreateShapeVisual()
                $borderGeometry = $script:PillCompositor.CreateRoundedRectangleGeometry()
                $borderGeometry.Offset = New-Object System.Numerics.Vector2([float]0.5, [float]0.5)
                $stroke = $script:PillCompositor.CreateSpriteShape($borderGeometry)
                $grey = New-Object Windows.UI.Color
                $grey.A = 51; $grey.R = 128; $grey.G = 128; $grey.B = 128
                $stroke.StrokeBrush = $script:PillCompositor.CreateColorBrush($grey)
                $stroke.StrokeThickness = 1
                $border.Shapes.Add($stroke)
                $root.Children.InsertAtTop($border)
                $script:PillVisuals[$key].border = $border
                $script:PillVisuals[$key].borderGeometry = $borderGeometry
            }
        }
        $visuals = $script:PillVisuals[$key]
        $visuals.root.Size = $size
        $visuals.shape.Size = $size
        $radius = if ($row[3]) { 0 } else { [float]($row[2]/2) }
        $visuals.shape.CornerRadius = New-Object System.Numerics.Vector2($radius, $radius)
        $visuals.blur.Size = $size
        $visuals.tint.Size = $size
        if (!$row[3]) {
            $visuals.border.Size = $size
            $visuals.borderGeometry.Size = New-Object System.Numerics.Vector2([float]($row[1]-1), [float]($row[2]-1))
            $visuals.borderGeometry.CornerRadius = New-Object System.Numerics.Vector2([float]($radius-0.5), [float]($radius-0.5))
        }
        if ($row[4] -and !$script:PillShown.ContainsKey($key)) {
            # Spotify fades in with its content instead of popping in.
            $fade = $script:PillCompositor.CreateScalarKeyFrameAnimation()
            $fade.InsertKeyFrame([float]0, [float]0)
            $fade.InsertKeyFrame([float]1, [float]1)
            $fade.Duration = [TimeSpan]::FromMilliseconds(220)
            $visuals.root.StartAnimation('Opacity', $fade)
        }
    }
    foreach ($key in $script:PillShown.Keys) {
        # A hidden layer starts transparent so the next show cannot flash at full opacity.
        if (!$shown.ContainsKey($key) -and $script:PillVisuals.ContainsKey($key)) { $script:PillVisuals[$key].root.Opacity = 0 }
    }
    $script:PillShown = $shown
    [PastelAcrylic]::Pump()
    return $script:PillVisuals.Count
}
