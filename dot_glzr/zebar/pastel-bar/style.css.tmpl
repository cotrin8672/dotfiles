:root {
  color-scheme: dark;
  font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
  font-synthesis: none;
  color: #ececf1;
  --cpu: #93b8ee;
  --gpu: #88cba8;
  --ram: #dca1bd;
  --codex: #447975;
  --claude: #e7a08a;
  --muted: #adb2bc;
  --track: rgba(236, 236, 241, .16);
  --divider: rgba(236, 236, 241, .18);
}
* { box-sizing: border-box; }
html, body { margin: 0; background: transparent; overflow: hidden; }
body { user-select: none; }
.symbols { position: absolute; width: 0; height: 0; overflow: hidden; }
.bar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(160px, 320px) minmax(0, 1fr);
  align-items: start;
  column-gap: 36px;
  height: 52px;
  padding: 8px 16px 10px;
}
.pill {
  height: 34px;
  border-radius: 999px;
  background: transparent;
  display: flex;
  align-items: center;
  min-width: 0;
}
.hardware { justify-self: start; padding: 0 4px; }
.icon {
  width: 20px; height: 20px; flex-shrink: 0;
  fill: none; stroke: currentColor; stroke-width: 1.65;
  stroke-linecap: round; stroke-linejoin: round;
}
.metric {
  display: flex; align-items: center; gap: 8px;
  padding: 0 12px; height: 24px;
}
.metric + .metric, .provider + .provider { border-left: 1px solid var(--divider); }
.cpu { --accent: var(--cpu); }
.gpu { --accent: var(--gpu); }
.ram { --accent: var(--ram); }
.codex { --accent: var(--codex); --frame: #a6cec7; }
.claude { --accent: var(--claude); --frame: #ffc38d; }
.metric .icon, .provider .icon { color: var(--accent); }
.reading { display: flex; flex-direction: column; justify-content: center; gap: 0; width: 38px; flex: 0 0 38px; }
.caption { font-size: 8px; line-height: 11px; font-weight: 600; letter-spacing: .3px; color: var(--muted); }
.value { font-size: 14px; line-height: 15px; font-weight: 400; font-variant-numeric: tabular-nums; }
.spark { width: 60px; height: 22px; overflow: visible; }
.spark .line { fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.spark .area { fill: var(--accent); opacity: .18; }
.active-window { justify-content: center; gap: 9px; padding: 0 18px; width: max-content; max-width: 100%; min-width: 168px; justify-self: center; }
.active-window .icon { width: 17px; height: 17px; color: var(--muted); }
#app-icon { object-fit: contain; flex-shrink: 0; }
#window-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; line-height: 18px; }
#window-title-text { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; vertical-align: top; }
#window-title.is-scrolling { text-overflow: clip; }
#window-title.is-scrolling #window-title-text { max-width: none; overflow: visible; }
.ai { justify-self: end; padding: 0 4px; }
.provider { display: flex; align-items: center; gap: 10px; height: 24px; padding: 0 16px; }
.provider .icon { width: 21px; height: 21px; }
.provider .brand-icon { width: 21px; height: 21px; object-fit: contain; flex-shrink: 0; }
.codex .brand-icon { filter: brightness(0) invert(1); }
.provider-name { min-width: 37px; font-size: 12px; line-height: 12px; font-weight: 600; }
.quotas { display: flex; flex-direction: column; justify-content: center; gap: 4px; min-width: 108px; }
.quota { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 35px; align-items: center; gap: 4px; width: 108px; height: 11px; padding: 0 6px; overflow: hidden; border-radius: 3px; line-height: 11px; }
.track { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; background: var(--track); }
.fill { display: block; height: 100%; background: var(--accent); opacity: .42; }
.quota:nth-child(2) .fill { opacity: .34; }
.quota-value { position: relative; font-size: 10px; font-weight: 400; text-align: right; font-variant-numeric: tabular-nums; }
.reset-time { position: relative; font-size: 9px; font-weight: 400; line-height: 11px; font-variant-numeric: tabular-nums; }
.reset-frame { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.reset-frame rect { fill: none; stroke-width: 1.5; }
.frame-base { stroke: var(--frame); stroke-opacity: .18; }
.reset-frame .frame-progress { stroke: var(--frame); stroke-width: 1.5; clip-path: inset(0 calc(100% - var(--remaining, 0%)) 0 0) view-box; }
.empty { color: var(--muted); font-size: 11px; }
.provider.stale .quotas { opacity: .55; }
.provider.stale .provider-name::after { content: " ·"; color: #ad8960; }
body.disconnected .hardware, body.disconnected .ai { opacity: .55; }
body.disconnected .active-window { opacity: .7; }
[hidden] { display: none !important; }
:root[data-group] .bar { display: block; padding: 0; height: 100vh; }
:root[data-group="bar"] .bar { display: none; }
:root[data-group="hardware"] .active-window, :root[data-group="hardware"] .ai,
:root[data-group="active"] .hardware, :root[data-group="active"] .ai,
:root[data-group="ai"] .hardware, :root[data-group="ai"] .active-window { display: none; }
:root[data-group] .pill { width: 100%; height: 34px; border-radius: 999px; }
:root[data-group="active"] .active-window { max-width: none; }
:root[data-group="hardware"] .metric { padding: 0 12px; gap: 8px; }
:root[data-group="hardware"] .spark { width: 60px; }
:root[data-group="ai"] .provider { padding: 0 16px; gap: 10px; }
:root[data-group="ai"] .provider-name { display: inline; }
:root[data-group="ai"] .quotas { min-width: 108px; }
@media (max-width: 1250px) {
  .bar { column-gap: 20px; grid-template-columns: minmax(0, 1fr) minmax(140px, 240px) minmax(0, 1fr); }
  .metric { padding: 0 9px; gap: 6px; }
  .spark { width: 48px; }
  .provider { padding: 0 10px; gap: 6px; }
}
@media (max-width: 1040px) {
  .bar { column-gap: 16px; padding-inline: 10px; grid-template-columns: auto minmax(100px, 1fr) auto; }
  .metric { padding: 0 8px; }
  .spark { width: 34px; }
  .provider-name { display: none; }
  .active-window { min-width: 0; padding-inline: 12px; }
}
