+func TestCodexCompatibilityEdit(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "space 日本語 #%.ts")
+	if err := os.WriteFile(path, []byte("日本語😀 greet\n"), 0600); err != nil {
+		t.Fatal(err)
