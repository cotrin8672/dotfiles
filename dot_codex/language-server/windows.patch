+package protocol
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestCodexCompatibilityURI(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "space 日本語 #%.ts")
+	uri := URIFromPath(path)
+	if got := uri.Path(); got != path {
+		t.Fatalf("round trip: %q != %q", got, path)
+	}
+	parsed, err := ParseDocumentUri(string(uri))
+	if err != nil || parsed != uri {
+		t.Fatalf("parse: %v %v", parsed, err)
+	}
+}
+
+func TestCodexCompatibilityUTF16(t *testing.T) {
+	if offset, err := UTF16Offset("日本語😀 greet", 6); err != nil || offset != 14 {
+		t.Fatalf("offset: %d %v", offset, err)
+	}
+	if _, err := UTF16Offset("日本語😀", 4); err == nil {
+		t.Fatal("a split surrogate pair must be rejected")
+	}
+}
