new file mode 100644
--- /dev/null
+++ b/internal/protocol/utf16.go
@@ -0,0 +1,24 @@
+package protocol
+
+import "fmt"
+
+// UTF16Offset converts LSP columns to byte offsets, clamping beyond end of line.
+func UTF16Offset(text string, column int) (int, error) {
+	if column < 0 {
+		return 0, fmt.Errorf("negative UTF-16 column: %d", column)
+	}
+	units := 0
+	for offset, r := range text {
+		if units == column {
+			return offset, nil
+		}
+		units++
+		if r > 0xffff {
+			units++
+		}
+		if units > column {
+			return 0, fmt.Errorf("UTF-16 column %d splits a surrogate pair", column)
+		}
+	}
+	return len(text), nil
+}
