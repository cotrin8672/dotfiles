{{- /* chezmoi:modify-template */ -}}
{{- /* Keep credentials and other machine-local settings out of the source state. */ -}}
{{- $input := .chezmoi.stdin | trim -}}
{{- $targetPath := joinPath .chezmoi.destDir ".opencodex" "config.json" -}}
{{- $target := lstat $targetPath -}}
{{- if and (not $input) $target (eq $target.type "symlink") (not (stat $targetPath)) -}}
{{- $revision := output "git" "-C" .chezmoi.sourceDir "log" "-1" "--format=%H" "--diff-filter=AM" "--" "dot_opencodex/private_config.json" | trim -}}
{{- if not $revision -}}{{ fail "Cannot recover the old OpenCodex config from Git history; restore the linked config before applying." }}{{- end -}}
{{- $input = output "git" "-C" .chezmoi.sourceDir "show" (printf "%s:dot_opencodex/private_config.json" $revision) -}}
{{- end -}}
{{- if not $input -}}
{{- $input = includeTemplate "opencodex-config.json" . -}}
{{- end -}}
{{- $config := fromJson $input -}}
{{- $models := list "codestral-latest" "mistral-large-4" "deepseek-v4-1-flash-1017" "zai-glm-5-3" -}}
{{- $config = $config
  | setValueAtPath "providers.mistral.adapter" "openai-chat"
  | setValueAtPath "providers.mistral.baseUrl" "https://api.mistral.ai/v1"
  | setValueAtPath "providers.mistral.authMode" "key"
  | setValueAtPath "providers.mistral.defaultModel" "codestral-latest"
  | setValueAtPath "providers.mistral.models" $models
  | setValueAtPath "providers.mistral.selectedModels" $models
  | setValueAtPath "providers.mistral.liveModels" false
  | deleteValueAtPath "providers.mistral.initialModelSelection"
  | setValueAtPath "providers.mistral.reasoningEfforts" (list)
  | setValueAtPath "providers.mistral.modelContextWindows.codestral-latest" 256000
  | setValueAtPath "providers.mistral.modelContextWindows.mistral-large-4" 1048576
  | setValueAtPath "providers.mistral.modelContextWindows.deepseek-v4-1-flash-1017" 1048576
  | setValueAtPath "providers.mistral.modelContextWindows.zai-glm-5-3" 1048576
  | setValueAtPath "providers.mistral.modelInputModalities.codestral-latest" (list "text")
  | setValueAtPath "providers.mistral.modelInputModalities.mistral-large-4" (list "text" "image")
  | setValueAtPath "providers.mistral.modelInputModalities.deepseek-v4-1-flash-1017" (list "text" "image")
  | setValueAtPath "providers.mistral.modelInputModalities.zai-glm-5-3" (list "text")
-}}
{{- $disabled := get $config "disabledModels" | default list -}}
{{- $order := get $config "modelPickerOrder" | default list -}}
{{- range $model := $models -}}
{{- $id := printf "mistral/%s" $model -}}
{{- $disabled = without $disabled $id -}}
{{- if not (has $id $order) -}}{{- $order = append $order $id -}}{{- end -}}
{{- end -}}
{{- $config = $config
  | setValueAtPath "disabledModels" $disabled
  | setValueAtPath "modelPickerOrder" $order
-}}
{{- $config | toPrettyJson -}}
